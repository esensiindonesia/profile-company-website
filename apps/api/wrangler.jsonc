{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "esensi-indonesia-api",
  "account_id": "a1e54833e74c6fdfd3ae6183f5cb839a",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "CORS_ORIGIN": "https://esensi-indonesia-web-5hq.pages.dev,https://esensiindonesia.com,https://www.esensiindonesia.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "esensi-indonesia-new",
      "database_id": "80559e02-01ee-48cb-82ad-36a5a8017139",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "esensi-indonesia"
    }
  ]
}
